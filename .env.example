# 이 파일을 복사해서 .env.local 을 만들고 값을 채우세요:  cp .env.example .env.local
# (.env.local 은 git에 올라가지 않습니다)

# 백엔드 API 주소. 비워두면 현재 사이트 주소의 /api 로 요청합니다. (개발 중 권장: 비워두기)
VITE_API_BASE_URL=

# 개발 서버(npm run dev)가 /api 요청을 전달할 백엔드 주소
VITE_PROXY_TARGET=http://localhost:8080

# 구글 OAuth (백엔드의 GOOGLE_CLIENT_ID / GOOGLE_REDIRECT_URI 와 같은 값이어야 함. client secret은 프론트에 두지 않는다)
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback/google
